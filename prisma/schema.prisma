generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users (CDP, Candidat, Assesseur)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   // "CDP", "CANDIDATE", "ASSESSOR"
  supabaseId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projectsManaged  Project[]  @relation("CDPManages")
  candidateProfile Candidate?
  assessorProfile  Assessor?
}

// Projects (Assessment Centers)
model Project {
  id        String   @id @default(cuid())
  clientName String
  position  String
  description String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING") // PENDING, PRE_AC, ACTIVE, COMPLETED
  cdpId     String
  cdp       User     @relation("CDPManages", fields: [cdpId], references: [id])

  candidates   Candidate[]
  exercises    Exercise[]
  assessments  Assessment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cdpId])
}

// Candidates
model Candidate {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  // Pre-AC
  hoganCompleted Boolean @default(false)
  hoganCompletedAt DateTime?
  preAcQuestionnaireCompleted Boolean @default(false)
  preAcQuestionnaireCompletedAt DateTime?

  // Assessment Day
  hoganResponses Json? // Store Hogan responses
  preAcResponses Json? // Store pre-AC responses
  postAcResponses Json? // Store post-AC responses

  assessments Assessment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// Assessors
model Assessor {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  role      String   // "LEAD", "SECOND"

  assessmentAssignments AssessmentAssignor[]
  assessorNotes AssessorNote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Exercises (CBI, Étude de cas, etc.)
model Exercise {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String   // "CBI", "HOGAN_INTERVIEW", "CASE_STUDY", "PRESENTATION", "ROLE_PLAY", etc.
  duration  Int      // minutes
  order     Int      // Order in assessment day
  description String?
  requiresTeams Boolean @default(false)
  instructions Json?

  assessmentSteps AssessmentStep[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Assessment (Instance of AC for a candidate)
model Assessment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  status      String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  scheduledAt DateTime
  completedAt DateTime?

  steps       AssessmentStep[]
  assignedAssessors AssessmentAssignor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([candidateId])
}

// Assessment Steps (Each exercise instance)
model AssessmentStep {
  id          String   @id @default(cuid())
  assessmentId String
  assessment  Assessment @relation(fields: [assessmentId], references: [id])
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  status      String   @default("LOCKED") // LOCKED, AVAILABLE, ACTIVE, COMPLETED, EXPIRED
  startTime   DateTime
  endTime     DateTime
  teamsLink   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assessmentId])
  @@index([exerciseId])
}

// Assessment Assignor (Link between Assessor and Assessment)
model AssessmentAssignor {
  id          String   @id @default(cuid())
  assessmentId String
  assessment  Assessment @relation(fields: [assessmentId], references: [id])
  assessorId  String
  assessor    Assessor @relation(fields: [assessorId], references: [id])
  role        String   // "LEAD", "SECOND"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assessmentId, assessorId])
}

// Assessor Notes (Pre and Post AC)
model AssessorNote {
  id          String   @id @default(cuid())
  assessorId  String
  assessor    Assessor @relation(fields: [assessorId], references: [id])

  type        String   // "PREP", "OBSERVATION", "SCORE"
  content     String
  competencies Json? // Store scores per competency

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assessorId])
}
